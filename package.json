{
  "name": "@koinx/xui",
  "version": "1.0.0",
  "description": "KoinX design system — components, tokens and icons, derived from Figma.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chebrolu-Tejopriya/xui.git"
  },
  "files": [
    "dist",
    "mcp",
    "xui.manifest.json",
    "xui.rulebook.json"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/xui.js"
    },
    "./styles.css": "./dist/xui.css",
    "./manifest": "./xui.manifest.json",
    "./rulebook": "./xui.rulebook.json",
    "./package.json": "./package.json"
  },
  "module": "./dist/xui.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint:tokens:fix": "node scripts/lint-tokens.mjs --fix",
    "test": "vitest run",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ds:build": "node scripts/build-rulebook.mjs && node scripts/gen-manifest.mjs",
    "ds:check": "npm run ds:build && npm run lint:tokens",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "prepare": "npm run build:lib",
    "release": "npm run ds:check && npm run typecheck && npm run lint && npm run build:lib && node scripts/tag-release.mjs",
    "check:xemantics": "node scripts/check-xemantics.mjs",
    "mcp": "node mcp/server.mjs",
    "test:visual": "npm run build-storybook && playwright test",
    "test:visual:update": "npm run build-storybook && playwright test --update-snapshots",
    "check:consumer": "npm run build:lib && tsc -p scripts/consumer-check/tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "bin": {
    "xui-mcp": "./mcp/server.mjs"
  }
}

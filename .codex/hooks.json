{
  "description": "GENERATED from the hooks in .claude/settings.json by scripts/gen-agent-rules.mjs. Do not edit - edit the source and run npm run ds:build.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/parity-reminder.mjs",
            "timeout": 15,
            "statusMessage": "Checking component parity gate"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/learning-nudge.mjs",
            "timeout": 10,
            "statusMessage": "Checking for a correction worth recording"
          }
        ]
      }
    ]
  }
}
